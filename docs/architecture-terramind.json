    {
      "dot": "cyan",
      "title": "Data Honesty — Always Visible in UI",
      "items": [
        "Preference order: 1) SIATA historical (sep-2024)  2) Open-Meteo CAMS (~11km model, current)  3) Deterministic simulated (offline fallback)",
        "Every datapoint shows source + quality flag (VALID / MISSING / SIMULATED)",
        "No silent substitution — UI declares origin explicitly"
      ]
    },
    {
      "dot": "emerald",
      "title": "Anti-Hallucination Contract (AGENTS.md §6)",
      "items": [
        "Copilot responses MUST include: confidence_score (0.0–1.0), sources[] with DOI/URL, spatial_features GeoJSON, metrics with unit + threshold_status",
        "No source → explicitly declared in response",
        "RAG citations from indexed env law docs (Ley 99/1993, Decreto 1076/2015, Res 631/2015, etc.)"
      ]
    },
    {
      "dot": "violet",
      "title": "OmniRoute — Cascading Fallback",
      "items": [
        "Configured provider first → other credentialed providers → Ollama if default → local mock",
        "Mock returns geo-specific Valle de Aburrá response (not generic) so UI never breaks",
        "Provider-agnostic: Groq, OpenRouter, DeepSeek, Ollama, custom endpoints"
      ]
    },
    {
      "dot": "amber",
      "title": "Current State (PRD §11 — UI-First Integration)",
