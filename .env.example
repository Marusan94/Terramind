# ==============================================================================
# TerraMind Environment Configuration Template
# Copy this file to .env and fill in your confidential values.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate_a_secure_random_key_here

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=terramind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/terramind

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Model Routing & AI Providers (OmniRoute)
# Options: openrouter, ollama, custom
DEFAULT_LLM_PROVIDER=openrouter
GROQ_API_KEY=TUS_KEY_AQUI
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Frontend (Vite) chat keys — copy to apps/web/.env.local (chain: Gemini → Groq → OpenRouter)
# Gemini gratis: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Groq gratis: https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_MODEL=deepseek/deepseek-chat
FAST_MODEL=meta-llama/llama-3-8b-instruct
REASONING_MODEL=deepseek/deepseek-r1

# Local LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Geospatial & Satellite Services (Optional / Free Tier)
MAPBOX_ACCESS_TOKEN=
COPERNICUS_API_KEY=
OPENWEATHER_API_KEY=
OPERA_WATER_API_KEY=
# NASA FIRMS (focos de incendio en vivo, gratis con registro):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/ → copiar a apps/web/.env.local
# Sin key la app usa focos demo etiquetados.
VITE_FIRMS_MAP_KEY=

# Vector Database (pgvector embedded or external)
VECTOR_DB_COLLECTION=terramind_docs
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# RAG documental (backend pgvector + ingesta diaria SIATA)
RAG_OFFLINE=False
RAG_TOP_K=8
RAG_MIN_SCORE=0.25
# True en servidor: crea tablas, ingiere informe SIATA de hoy y programa 06:00 America/Bogota
RAG_AUTO_INGEST=False
# memory = demo local sin Postgres | pgvector = produccion
RAG_STORE=memory
# Seed demo al arrancar en modo memoria
RAG_DEMO_SEED=True
# URL del API para que el frontend use el RAG backend (vacio = solo RAG local)
VITE_API_URL=
