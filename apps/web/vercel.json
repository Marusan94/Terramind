{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
        "destination": "https://calendar-ia.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/medellin/:path*",
      "destination": "https://www.medellin.gov.co/servidormapas/:path*"
    },
    {
      "source": "/api/geoportal/:path*",
      "destination": "https://geoportal.siata.gov.co/:path*"
    },
    {
      "source": "/api/siata/:path*",
      "destination": "https://siata.gov.co/:path*"
    },
    {
      "source": "/api/firms/:path*",
      "destination": "https://firms.modaps.eosdis.nasa.gov/:path*"
    },
    {
      "source": "/api/llm/groq/:path*",
      "destination": "https://api.groq.com/openai/v1/:path*"
    },
    {
      "source": "/api/llm/openrouter/:path*",
      "destination": "https://openrouter.ai/api/v1/:path*"
    },
    {
      "source": "/api/llm/gemini/:path*",
      "destination": "https://generativelanguage.googleapis.com/v1beta/:path*"
    },
    {
      "source": "/((?!api/|assets/|system/|favicon.svg|manifest.json|sw.js|icon-.*|screenshot\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/carto-tiles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
